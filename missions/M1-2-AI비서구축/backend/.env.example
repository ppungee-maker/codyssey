# 값이 아니라 형식만 공유합니다. 실제 값은 .env 에만 넣고 커밋하지 마세요(.gitignore 처리됨).

# 없으면 mock LLM으로 자동 대체(로컬 개발 기본값)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 없으면 in-memory store로 자동 대체(로컬 개발 기본값)
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은 JSON 파일의
# 전체 내용을 "한 줄 문자열"로 그대로 붙여넣는다 (파일 경로가 아니라 내용 자체).
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# 프론트엔드 배포 URL (Vercel). 콤마로 여러 개 가능. 비우면 전체 허용(*)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
